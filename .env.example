# 이 파일은 형식만 보여주는 예시입니다 — 실제 키는 .env 에 넣으세요 (.env 는 .gitignore 됨)
# 셋 중 하나만 채워도 동작하며, 여러 개 있으면 모두 검색해 더 나은 사진을 고릅니다.

# https://unsplash.com/oauth/applications 에서 앱 생성 후 Access Key 복사
# Demo 앱 기준 시간당 50회
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Unsplash에 등록한 앱 이름 (attribution UTM 파라미터에 사용)
UNSPLASH_APP_NAME=cardnews-surfing-magazine

# https://www.pexels.com/api/ 에서 발급 (가입 즉시 발급, 승인 대기 없음)
# 시간당 200회 / 월 20,000회
PEXELS_API_KEY=your_pexels_api_key_here

# https://pixabay.com/api/docs/ 로그인 후 페이지 상단에서 확인 (가입 즉시 발급)
# 60초당 100회 / 검색 결과는 24시간 캐시 필수 (API 이용약관)
PIXABAY_API_KEY=your_pixabay_api_key_here

# Openverse 는 API 키가 필요 없습니다 (익명 20회/분, 200회/일) — 여기에 적을 값이 없습니다.
