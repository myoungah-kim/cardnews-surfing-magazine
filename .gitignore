# API 키 (절대 커밋 금지)
.env

# 스톡 이미지 원본 / 캐시
input/*.jpg
input/*.jpeg
input/*.png
!input/.gitkeep
.cache/

# humanize-korean 스킬 작업 폴더 (윤문 중간 산출물)
_workspace/

__pycache__/

# macOS 가 폴더를 열 때마다 만드는 파일 — 저장소에 들어갈 이유가 없다
.DS_Store

# 릴즈용 배경음악.
# 원본 음원은 "영상에 합성해 쓰는 것"만 허용된 라이선스라, 파일 자체를 공개
# 저장소에 두면 안 된다. 대신 gpg 대칭암호로 암호화한 .gpg 만 커밋하고,
# 복호화 암호는 GitHub secret(BGM_PASSPHRASE)에 둔다 — 러너가 실행 시점에만 푼다.
#
# 디렉터리를 통째로(`input/bgm/`) 무시하면 git 이 그 안으로 들어가지 않아
# 아래 `!` 예외가 먹지 않는다. 반드시 `input/bgm/*` 형태여야 한다.
input/bgm/*
!input/bgm/*.gpg

# automation (Node / Cloudflare Workers)
node_modules/
.wrangler/
# wrangler 로컬 개발용 시크릿 — 절대 커밋 금지
.dev.vars
